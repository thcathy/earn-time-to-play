# Android signing configuration
# Copy this file to key.properties and fill in your values
# DO NOT commit key.properties to version control!
#
# Used by Gradle release builds (flutter build appbundle --release).
# Fastlane android lanes call the same Flutter build.

storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=upload-keystore.jks
