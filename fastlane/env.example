# Copy to fastlane/.env (gitignored):
#   cp fastlane/env.example fastlane/.env

# ---- Android / Google Play ----
ANDROID_PACKAGE_NAME=com.thcathy.earntimetoplay
PLAY_STORE_JSON_KEY=fastlane/play-store-key.json

# Track: internal | alpha | beta | production
PLAY_TRACK=internal
# Status: draft (required while app is Draft in Play Console) | completed | inProgress | halted
PLAY_RELEASE_STATUS=draft
# Optional staged rollout for production (0.0 - 1.0), e.g. 0.1 = 10%
# PLAY_ROLLOUT=0.1

# Promote lane (android promote)
# PLAY_PROMOTE_FROM=internal
# PLAY_PROMOTE_TO=production
# PLAY_VERSION_CODE=12

# Upload toggles
SKIP_UPLOAD_METADATA=false
SKIP_UPLOAD_IMAGES=true
SKIP_UPLOAD_SCREENSHOTS=true
SKIP_UPLOAD_CHANGELOGS=false
# PLAY_VALIDATE_ONLY=true

# ---- Android signing (Gradle, not Fastlane) ----
# Create android/key.properties from android/key.properties.template
# storeFile points to your upload-keystore.jks (gitignored)
