# Copy to fastlane/.env (gitignored) and fill in real values:
#   cp fastlane/env.example fastlane/.env

# ---- App identity ----
APP_IDENTIFIER=com.thcathy.earntimetoplay
APPLE_ID=thcathy@gmail.com
APPLE_TEAM_ID=DU483K8F48
# ITC_TEAM_ID=        # only if you belong to multiple App Store Connect teams

# ---- App Store Connect API key (recommended; avoids Apple ID 2FA prompts) ----
# Create at: App Store Connect → Users and Access → Integrations → App Store Connect API
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_API_ISSUER_ID=
APP_STORE_CONNECT_API_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXX.p8
# Or paste PEM contents (use \n for newlines):
# APP_STORE_CONNECT_API_KEY_CONTENT=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# ---- Match (shared signing) — optional; without it, Automatic Signing is used ----
MATCH_GIT_URL=git@github.com:thcathy/certificates.git
MATCH_PASSWORD=
# MATCH_GIT_BASIC_AUTHORIZATION=   # base64 of "user:token" for HTTPS git
# MATCH_KEYCHAIN_NAME=fastlane_tmp_keychain
# MATCH_KEYCHAIN_PASSWORD=

# ---- Release behavior ----
SUBMIT_FOR_REVIEW=true
AUTOMATIC_RELEASE=false
PHASED_RELEASE=true
SKIP_SCREENSHOTS=true
SKIP_METADATA=false
SKIP_WAITING_FOR_BUILD_PROCESSING=true
# INCREMENT_BUILD_NUMBER=true
# TESTFLIGHT_CHANGELOG=Bug fixes and improvements
