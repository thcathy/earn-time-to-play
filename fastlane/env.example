# Copy to fastlane/.env (gitignored) and fill in real values:
#   cp fastlane/env.example fastlane/.env

# ---- App identity ----
APP_IDENTIFIER=com.thcathy.earntimetoplay
APPLE_ID=thcathy@gmail.com
APPLE_TEAM_ID=DU483K8F48
# ITC_TEAM_ID=        # only if you belong to multiple App Store Connect teams

# ---- App Store Connect API key (recommended; avoids Apple ID 2FA prompts) ----
# Create at: App Store Connect → Users and Access → Integrations → App Store Connect API
# Leave these commented to use Apple ID login. An empty KEY_PATH breaks deliver.
# APP_STORE_CONNECT_API_KEY_ID=
# APP_STORE_CONNECT_API_ISSUER_ID=
# APP_STORE_CONNECT_API_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXX.p8
# Or paste PEM contents (use \n for newlines):
# APP_STORE_CONNECT_API_KEY_CONTENT=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# ---- Match (shared signing) — optional; without it, Automatic Signing is used ----
MATCH_GIT_URL=git@github.com:thcathy/certificates.git
MATCH_PASSWORD=
# MATCH_GIT_BASIC_AUTHORIZATION=   # base64 of "user:token" for HTTPS git
# MATCH_KEYCHAIN_NAME=fastlane_tmp_keychain
# MATCH_KEYCHAIN_PASSWORD=

# ---- iOS release behavior ----
SUBMIT_FOR_REVIEW=true
AUTOMATIC_RELEASE=true
PHASED_RELEASE=true
SKIP_SCREENSHOTS=true
SKIP_METADATA=false
SKIP_WAITING_FOR_BUILD_PROCESSING=true
# SKIP_BUILD=true            # reuse existing IPA / AAB
# SKIP_BINARY_UPLOAD=true    # submit lane: App Store Connect build only
# INCREMENT_BUILD_NUMBER=true
# TESTFLIGHT_CHANGELOG=Bug fixes and improvements

# ---- Android / Google Play ----
ANDROID_PACKAGE_NAME=com.thcathy.earntimetoplay
PLAY_STORE_JSON_KEY=fastlane/play-store-key.json

# Track: internal | alpha | beta | production (beta / validate)
PLAY_TRACK=internal
# Internal/validate status. draft is required until the Play app itself is published once.
PLAY_RELEASE_STATUS=draft
# Production (android release / promote): completed submits for Google review, then rolls out.
# While the Play app is still Draft, Fastlane retries as draft automatically.
PLAY_PRODUCTION_STATUS=completed
# Optional staged rollout for production (0.0 - 1.0), e.g. 0.1 = 10%
# PLAY_ROLLOUT=0.1
# false = send the edit for review (needed for auto-submit). Leave unset.
# PLAY_CHANGES_NOT_SENT_FOR_REVIEW=false

# Auto-publish after Google approval is a Play Console setting, not an API flag:
#   Play Console → Publishing overview → turn Managed publishing OFF
# (same idea as iOS AUTOMATIC_RELEASE=true)

# android release promotes by default (internal → production, no rebuild).
# PLAY_UPLOAD_AAB=true   # instead: build and upload a new AAB to production
# PLAY_RELEASE_TRACK=production
# PLAY_PROMOTE_FROM=internal
# PLAY_PROMOTE_TO=production
# PLAY_VERSION_CODE=13

# Upload toggles
SKIP_UPLOAD_METADATA=false
SKIP_UPLOAD_IMAGES=true
SKIP_UPLOAD_SCREENSHOTS=true
SKIP_UPLOAD_CHANGELOGS=false
# PLAY_VALIDATE_ONLY=true

# ---- Android signing (Gradle, not Fastlane) ----
# Create android/key.properties from android/key.properties.template
# storeFile points to your upload-keystore.jks (gitignored)
